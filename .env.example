# Copia este archivo a ".env" y rellena tu clave.
# La clave de Anthropic es necesaria para escanear recibos con la cámara.
# Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo de visión usado para leer los recibos (opcional).
RECEIPT_MODEL=claude-sonnet-5

# Moneda por defecto de la app.
DEFAULT_CURRENCY=EUR
