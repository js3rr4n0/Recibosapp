# Copia este archivo a ".env" y rellena los valores.

# --- Base de datos ---
# En local puedes dejarlo vacío: se usará un SQLite en data/recibos.db.
# En producción (Vercel), pega aquí tu cadena de conexión de Neon (Postgres).
# Ejemplo Neon: postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Escaneo de recibos (visión de Claude) ---
# Necesaria para escanear recibos con la cámara. Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo de visión usado para leer los recibos (opcional).
RECEIPT_MODEL=claude-sonnet-5

# Moneda por defecto de la app.
DEFAULT_CURRENCY=EUR
