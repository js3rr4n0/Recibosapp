# Copia este archivo a ".env.local" (en local) o configura estas variables en
# el panel de Vercel (en producción).

# --- Base de datos (obligatorio) ---
# Cadena de conexión de Neon (Postgres), variante "pooled".
# Ejemplo: postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Escaneo de recibos (visión) ---
# Configura al menos una de estas claves. La app rota entre todos los modelos
# disponibles y hace fallback cuando uno se queda sin cuota.
# Gemini (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic (opcional): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# (Opcional) Orden/selección manual de modelos, separados por comas, con el
# formato "proveedor:modelo". Si se deja vacío, se usan todos los disponibles.
# Ejemplo: gemini:gemini-2.0-flash,gemini:gemini-2.5-flash,anthropic:claude-sonnet-5
RECEIPT_MODELS=

# Moneda por defecto de la app (EUR, USD, CRC, MXN, ...).
DEFAULT_CURRENCY=EUR
